        ai: fbState.ai, aiEngine: fbState.aiEngine,
        status: '未確認', statusReason: '', statusAt: '', seen: true
      };
      fbPosts.unshift(post);
      await IDB.set('rt_fb_posts', fbPosts);
      if (post.requestId) {
        const r = fbRequests.find(x => x.id === post.requestId);
        if (r) { r.answers = [...(r.answers || []), post.id]; await IDB.set('rt_fb_requests', fbRequests); }
      }
      resetForm();
      renderPosts(); renderRequests();
