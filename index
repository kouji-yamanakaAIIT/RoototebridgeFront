          const item = catData.items[itemKey];
          const btn = document.createElement('button');
          btn.type = 'button';
          btn.dataset.category = catKey;
          btn.dataset.val = itemKey;
          
          const isActive = arrangeState[catKey] === itemKey;
          btn.className = `preset-chip px-2.5 py-1 text-xs rounded-lg border transition ${
            isActive 
              ? 'active bg-indigo-600 text-white border-indigo-600 shadow-xs font-semibold' 
              : 'bg-slate-100 hover:bg-slate-200 text-slate-700 border-slate-200'
          }`;
          btn.textContent = item.label;

          btn.addEventListener('click', () => {
            if (arrangeState[catKey] === itemKey) {
              arrangeState[catKey] = '';
              btn.classList.remove('active');
            } else {
              chipWrapper.querySelectorAll('.preset-chip').forEach(c => c.classList.remove('active'));
              arrangeState[catKey] = itemKey;
              btn.classList.add('active');
            }
            rebuildArrangePrompt();
          });

          chipWrapper.appendChild(btn);
        });

        section.appendChild(chipWrapper);
        dynamicPresetContainer.appendChild(section);
      });
    }

    // ターゲット切り替えボタンのイベント
    targetWomenBtn.addEventListener('click', () => {
      if (currentGenderTarget === 'women') return;
      targetWomenBtn.className = 'py-1.5 px-3 rounded-lg transition-all flex items-center justify-center gap-1.5 bg-white text-pink-600 shadow-xs font-bold';
      targetMenBtn.className = 'py-1.5 px-3 rounded-lg transition-all flex items-center justify-center gap-1.5 text-slate-600 hover:text-slate-900';
      renderPresets('women');
      rebuildArrangePrompt();
      showToast('レディース人気トレンドを表示しました');
    });

    targetMenBtn.addEventListener('click', () => {
      if (currentGenderTarget === 'men') return;
      targetMenBtn.className = 'py-1.5 px-3 rounded-lg transition-all flex items-center justify-center gap-1.5 bg-white text-slate-900 shadow-xs font-bold';
      targetWomenBtn.className = 'py-1.5 px-3 rounded-lg transition-all flex items-center justify-center gap-1.5 text-slate-600 hover:text-slate-900';
      renderPresets('men');
      rebuildArrangePrompt();
      showToast('メンズ・ユニセックスを表示しました');
    });

    function rebuildArrangePrompt() {
      const parts = [];
      const labels = [];
      const data = PRESET_COLLECTIONS[currentGenderTarget];

      Object.keys(arrangeState).forEach(cat => {
        const key = arrangeState[cat];
        if (!key) return;

        let itemDef = data[cat]?.items[key];
        if (!itemDef) {
          const otherGender = currentGenderTarget === 'women' ? 'men' : 'women';
          itemDef = PRESET_COLLECTIONS[otherGender][cat]?.items[key];
        }

        if (itemDef) {
          parts.push(itemDef.prompt);
          labels.push(itemDef.label);
        }
      });

      if (parts.length > 0) {
        arrangePromptInput.value = `このトートバッグをリデザイン・アレンジ：${parts.join('。')}。バッグの基本形状・構造・使い勝手の良さは保ちつつ、清潔な無地背景での高品位スタジオ商品写真風に仕上げてください。`;
      } else {
        arrangePromptInput.value = '';
      }

      appliedSpecText.textContent = labels.length > 0 ? labels.join(' × ') : 'オリジナル仕様';
    }

    clearPresetsBtn.addEventListener('click', () => {
      Object.keys(arrangeState).forEach(k => arrangeState[k] = '');
      document.querySelectorAll('.preset-chip').forEach(c => c.classList.remove('active'));
      arrangePromptInput.value = '';
      appliedSpecText.textContent = 'オリジナル仕様';
      showToast('プリセットをリセットしました');
    });

    // アレンジ生成の実行（Gemini 3.1 Flash Image による画像編集）
    runArrangeBtn.addEventListener('click', async () => {
      if (!currentImageBase64) {
        showToast('左のメニューから製品を選んでください');
        return;
      }

      const promptToUse = arrangePromptInput.value.trim() || 'このトートバッグをプレミアムな淡色韓国カフェ風仕様にし、刺繍ディテールを追加してください。清潔な無地背景での高品位スタジオ商品写真。';

      runArrangeBtn.disabled = true;
      arrangeBtnIcon.textContent = '⏳';
      arrangeBtnText.textContent = 'アレンジ生成中...';
      arrangerInitialState.classList.add('hidden');
      arrangerPreviewContainer.classList.add('hidden');
      arrangerLoadingState.classList.remove('hidden');
      arrangerStatusIndicator.className = 'w-2.5 h-2.5 rounded-full bg-amber-400 animate-ping';

      const apiKey = getEffectiveApiKey();
      const apiUrl = `https://generativelanguage.googleapis.com/v1beta/models/gemini-3.1-flash-image:generateContent?key=${apiKey}`;

      try {
        const payload = {
          contents: [{
            parts: [
              { text: `Edit and rearrange this tote bag design based on the instruction: ${promptToUse}. Keep professional studio lighting, realistic textures, seams, and fabric depth.` },
              {
                inlineData: {
                  mimeType: 'image/jpeg',
                  data: currentImageBase64
                }
              }
            ]
          }],
          generationConfig: {
            responseModalities: ['IMAGE']
          }
        };

        const response = await fetchWithBackoff(apiUrl, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload)
        });

        const part = response?.candidates?.[0]?.content?.parts?.find(p => p.inlineData);
        if (!part) {
          throw new Error('画像データを受信できませんでした');
        }

        arrangedImageBase64 = part.inlineData.data;
        const resultUrl = `data:${part.inlineData.mimeType || 'image/png'};base64,${arrangedImageBase64}`;
        renderArrangedPreview(resultUrl, 'Gemini 3.1 Flash Image');

      } catch (err) {
        console.warn('AI APIアレンジ生成スキップ、内蔵デザインレンダラーを実行:', err);
        const fallbackUrl = renderDynamicMockup(promptToUse);
        renderArrangedPreview(fallbackUrl, '内蔵デザインシミュレータ');
        showToast(`内蔵シミュレータでプレビューを生成しました`);
      } finally {
        runArrangeBtn.disabled = false;
        arrangeBtnIcon.textContent = '🎨';
        arrangeBtnText.textContent = 'アレンジを生成・プレビュー';
      }
    });

    function renderArrangedPreview(imgUrl, engineName) {
      arrangerLoadingState.classList.add('hidden');
      arrangerPreviewContainer.classList.remove('hidden');
      arrangerStatusIndicator.className = 'w-2.5 h-2.5 rounded-full bg-emerald-500';

      arrangedResultImg.src = imgUrl;
      compareAfterImg.src = imgUrl;
      if (currentImageBase64) {
        compareBeforeImg.src = `data:image/jpeg;base64,${currentImageBase64}`;
      }

      engineBadge.textContent = engineName;
      downloadArrangedImgBtn.disabled = false;
    }

    viewAfterOnlyBtn.addEventListener('click', () => {
      viewAfterOnlyBtn.className = 'px-2.5 py-1 rounded-md bg-white text-indigo-700 shadow-xs font-semibold';
      viewSplitCompareBtn.className = 'px-2.5 py-1 rounded-md hover:text-slate-900';
      singleAfterWrapper.classList.remove('hidden');
      splitCompareWrapper.classList.add('hidden');
    });

    viewSplitCompareBtn.addEventListener('click', () => {
      viewSplitCompareBtn.className = 'px-2.5 py-1 rounded-md bg-white text-indigo-700 shadow-xs font-semibold';
      viewAfterOnlyBtn.className = 'px-2.5 py-1 rounded-md hover:text-slate-900';
      singleAfterWrapper.classList.add('hidden');
      splitCompareWrapper.classList.remove('hidden');
    });

    downloadArrangedImgBtn.addEventListener('click', () => {
      if (!arrangedResultImg.src) return;
      const a = document.createElement('a');
      a.href = arrangedResultImg.src;
      a.download = `arranged-tote-bag-${Date.now()}.png`;
      a.click();
    });

    copyArrangePromptBtn.addEventListener('click', () => {
      const text = arrangePromptInput.value.trim();
      if (!text) {
        showToast('コピーするプロンプトがありません');
        return;
      }
      const ok = copyTextSafely(text);
      showToast(ok ? 'アレンジプロンプトをコピーしました' : 'コピーに失敗しました');
    });

    // 内蔵SVG/Canvasリアルタイムデザインシミュレータ
    function renderDynamicMockup(prompt) {
      const ctx = mockupCanvas.getContext('2d');
      const w = mockupCanvas.width;
      const h = mockupCanvas.height;

      ctx.fillStyle = '#f8fafc';
      ctx.fillRect(0, 0, w, h);

      let bodyColor = '#E3DAC9';
      let handleColor = '#D1C7B5';
      let textColor = '#2C3E50';
      let accentColor = '#C0392B';
      let titleText = 'ATELIER';
      let subText = 'STUDIO DESIGN 2026';
      let isDark = false;

      const p = prompt.toLowerCase();

      if (arrangeState.material === 'ballistic-nylon' || p.includes('バリスティック') || arrangeState.color === 'stealth-black') {
        bodyColor = '#171717';
        handleColor = '#0A0A0A';
        textColor = '#E5E5E5';
        accentColor = '#525252';
        titleText = 'TACTICAL GEAR';
        subText = 'SPEC. 1050D NYLON';
        isDark = true;
      } else if (arrangeState.style === 'military-tactical' || arrangeState.color === 'olive-drab' || p.includes('ミリタリー') || p.includes('オリーブ')) {
        bodyColor = '#3F4A3C';
        handleColor = '#2B3329';
        textColor = '#D1DCD0';
        accentColor = '#E58A13';
        titleText = 'MIL-SPEC 99';
        subText = 'HEAVY-DUTY FIELD GEAR';
        isDark = true;
      } else if (arrangeState.color === 'dusty-rose' || p.includes('ピンク') || p.includes('rose') || p.includes('バレエ')) {
        bodyColor = '#F7E7E8';
        handleColor = '#E8C5C8';
        textColor = '#8C5E64';
        accentColor = '#D48B96';
        titleText = 'Chérie';
        subText = 'PARIS & TOKYO';
      } else if (arrangeState.color === 'milktea-latte' || p.includes('カフェ') || p.includes('ミルクティー') || p.includes('淡色')) {
        bodyColor = '#EFE9E1';
        handleColor = '#DDD2C3';
        textColor = '#6E5D4F';
        accentColor = '#A38B78';
        titleText = 'Café de Flore';
        subText = 'BONJOUR JOURNÉE';
      } else if (arrangeState.color === 'pistachio-mint' || p.includes('ピスタチオ')) {
        bodyColor = '#E2EBE4';
        handleColor = '#C8D9CC';
        textColor = '#4A6B53';
        accentColor = '#7BA686';
        titleText = 'PISTACHE';
        subText = 'JARDIN BOTANIQUE';
      } else if (arrangeState.material === 'nubi-quilt' || p.includes('ヌビ')) {
        bodyColor = '#F5EFE6';
        handleColor = '#E8DDCF';
        textColor = '#7A6B5D';
        accentColor = '#BFAFA2';
        titleText = 'NUBI QUILT';
        subText = 'ORGANIC SOFT COTTON';
      } else if (arrangeState.material === 'fluffy-boa' || p.includes('ボア')) {
        bodyColor = '#F2E8DC';
        handleColor = '#D4C0A8';
        textColor = '#5C4A3A';
        accentColor = '#8A6E55';
        titleText = 'TEDDY BOA';
        subText = 'WARM & FLUFFY';
      } else if (arrangeState.material === 'raw-selvedge' || p.includes('denim') || p.includes('デニム')) {
        bodyColor = '#243B55';
        handleColor = '#141E30';
        textColor = '#FFFFFF';
        accentColor = '#B8860B';
        titleText = 'SELVEDGE 16oz';
        subText = 'INDIGO RAW DENIM';
        isDark = true;
      }

      // ハンドルの描画
      ctx.beginPath();
      ctx.strokeStyle = handleColor;
      ctx.lineWidth = 44;
      ctx.lineCap = 'round';
      ctx.arc(w / 2, 260, 140, Math.PI, 0, false);
      ctx.stroke();

      if (arrangeState.layout === 'frill-handle' || p.includes('フリル')) {
        ctx.save();
        ctx.strokeStyle = accentColor;
        ctx.lineWidth = 14;
        ctx.setLineDash([12, 10]);
        ctx.arc(w / 2, 260, 155, Math.PI, 0, false);
        ctx.stroke();
        ctx.restore();
      }

      ctx.beginPath();
      ctx.strokeStyle = isDark ? '#FFFFFF33' : '#00000018';
      ctx.lineWidth = 3;
      ctx.setLineDash([8, 6]);
      ctx.arc(w / 2, 260, 140, Math.PI, 0, false);
      ctx.stroke();
      ctx.setLineDash([]);

      // ボディ
      ctx.save();
      ctx.shadowColor = 'rgba(0, 0, 0, 0.14)';
      ctx.shadowBlur = 30;
      ctx.shadowOffsetY = 15;

      ctx.fillStyle = bodyColor;
      ctx.beginPath();
      ctx.moveTo(w * 0.22, 260);
      ctx.lineTo(w * 0.78, 260);
      ctx.lineTo(w * 0.74, 840);
      ctx.lineTo(w * 0.26, 840);
      ctx.closePath();
      ctx.fill();
      ctx.restore();

      // MOLLEウェビング
      if (arrangeState.layout === 'molle-system' || p.includes('molle')) {
        ctx.save();
        ctx.strokeStyle = '#222222';
        ctx.lineWidth = 18;
        [400, 440, 480].forEach(y => {
          ctx.beginPath();
          ctx.moveTo(w * 0.25, y);
          ctx.lineTo(w * 0.75, y);
          ctx.stroke();
          ctx.strokeStyle = '#FFFFFF44';
          ctx.lineWidth = 2;
          for (let x = w * 0.29; x < w * 0.72; x += 45) {
            ctx.beginPath();
            ctx.moveTo(x, y - 8);
            ctx.lineTo(x, y + 8);
            ctx.stroke();
          }
          ctx.strokeStyle = '#222222';
          ctx.lineWidth = 18;
        });
        ctx.restore();
      }

      // ヌビキルトステッチ
      if (arrangeState.material === 'nubi-quilt' || p.includes('ヌビ')) {
        ctx.save();
        ctx.strokeStyle = 'rgba(0, 0, 0, 0.08)';
        ctx.lineWidth = 2.5;
        for (let x = w * 0.25; x < w * 0.75; x += 22) {
          ctx.beginPath();
          ctx.moveTo(x, 260);
          ctx.lineTo(x, 840);
          ctx.stroke();
        }
        ctx.restore();
      }

      // 表面ノイズ
      ctx.save();
      ctx.globalAlpha = 0.05;
      for (let i = 0; i < 4000; i++) {
        ctx.fillStyle = i % 2 === 0 ? '#000000' : '#ffffff';
        ctx.fillRect(w * 0.23 + Math.random() * (w * 0.54), 265 + Math.random() * 570, 2, 2);
      }
      ctx.restore();

      // サイドリボン
      if (arrangeState.layout === 'side-ribbon' || p.includes('リボン') || p.includes('バレエ')) {
        [w * 0.22, w * 0.78].forEach(rx => {
          ctx.save();
          ctx.fillStyle = accentColor;
          ctx.beginPath();
          ctx.arc(rx, 340, 10, 0, Math.PI * 2);
          ctx.fill();
          ctx.beginPath();
          ctx.strokeStyle = accentColor;
          ctx.lineWidth = 6;
          ctx.lineCap = 'round';
          ctx.moveTo(rx, 340);
          ctx.bezierCurveTo(rx - (rx > w/2 ? -25 : 25), 420, rx - (rx > w/2 ? -15 : 15), 520, rx - (rx > w/2 ? -30 : 30), 580);
          ctx.stroke();
          ctx.restore();
        });
      }

      // ハンドル付け根ステッチ
      [w * 0.33, w * 0.67].forEach(x => {
        ctx.fillStyle = handleColor;
        ctx.fillRect(x - 22, 260, 44, 60);
        ctx.strokeStyle = isDark ? '#ffffff44' : '#00000033';
        ctx.lineWidth = 2;
        ctx.strokeRect(x - 18, 265, 36, 50);
        ctx.beginPath();
        ctx.moveTo(x - 18, 265);
        ctx.lineTo(x + 18, 315);
        ctx.moveTo(x + 18, 265);
        ctx.lineTo(x - 18, 315);
        ctx.stroke();
      });

      // グラフィック
      ctx.textAlign = 'center';

      if (arrangeState.layout === 'stencil-typography' || p.includes('ステンシル')) {
        ctx.save();
        ctx.fillStyle = accentColor;
        ctx.font = '900 38px "Impact", "Arial Black", sans-serif';
        ctx.letterSpacing = '4px';
        ctx.fillText(titleText, w / 2, 570);
        ctx.font = 'bold 12px monospace';
        ctx.fillStyle = isDark ? '#E5E5E5' : '#111827';
        ctx.fillText(subText, w / 2, 605);
        ctx.restore();
      } else if (arrangeState.layout === 'cursive-script' || arrangeState.style === 'korean-cafe') {
        ctx.save();
        ctx.fillStyle = textColor;
        ctx.font = 'italic 44px "Georgia", serif';
        ctx.fillText(titleText, w / 2, 480);
        ctx.font = '12px sans-serif';
        ctx.fillStyle = accentColor;
        ctx.letterSpacing = '3px';
        ctx.fillText(subText, w / 2, 520);
        ctx.restore();
      } else {
        ctx.save();
        ctx.strokeStyle = accentColor;
        ctx.lineWidth = 3;
        ctx.beginPath();
        ctx.arc(w / 2, 450, 65, 0, Math.PI * 2);
        ctx.stroke();

        ctx.fillStyle = textColor;
        ctx.font = 'bold 34px serif';
        ctx.fillText(titleText, w / 2, 565);

        ctx.font = '13px sans-serif';
        ctx.fillStyle = isDark ? '#CBD5E1' : '#64748B';
        ctx.fillText(subText, w / 2, 600);

        ctx.fillStyle = accentColor;
        ctx.fillRect(w / 2 - 50, 620, 100, 2.5);
        ctx.restore();
      }

      return mockupCanvas.toDataURL('image/png');
    }

    function getModeName(mode) {
      switch (mode) {
        case 'spec': return '製品仕様書 (Product Spec)';
        case 'prompt': return '画像生成プロンプト (Prompt)';
        case 'alt': return '忠実な外観記述 (Alt Text)';
        case 'ec': return 'EC出品用テキスト (Catalog Copy)';
        case 'talk': return '営業トーク (Sales Talk)';
        default: return '解析結果';
      }
    }

    copyBtn.addEventListener('click', () => {
      if (!rawOutputText) {
        showToast('コピーする解析結果がありません');
        return;
      }
      const success = copyTextSafely(rawOutputText);
      showToast(success ? 'テキストをコピーしました' : 'コピーに失敗しました');
    });

    downloadBtn.addEventListener('click', () => {
      if (!rawOutputText) {
        showToast('保存する解析結果がありません');
        return;
      }
      const blob = new Blob([rawOutputText], { type: 'text/markdown;charset=utf-8' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      const fp = lastRunInfo.product;
      const tag = fp ? (fp.custom ? 'custom' : fp.hinban || fp.no) : 'product';
      a.download = `rootote-${String(tag).replace(/[^\w-]+/g, '')}-${currentMode}${lastRunInfo.persona ? '-persona' : ''}-${Date.now()}.md`;
      a.click();
      URL.revokeObjectURL(url);
    });

    // 初期プリセットの読み込み
    window.addEventListener('load', async () => {
      renderPresets('women'); // デフォルトはレディース人気トレンド
      document.querySelector('.mode-btn[data-mode="spec"]').click();
      customProducts = (await IDB.get('rt_custom_products')) || [];
      const last = LS.get('rt_last_product');
      if (IS_SALES_APP) switchTab('feedback');
      await selectProduct(productById(last) ? last : CATALOG[0].items[0].id);
      await initFeedback();
      fbReady = true;
      await initDash();
      await initTalks();
    });
  </script>
