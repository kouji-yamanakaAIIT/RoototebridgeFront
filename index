        p.concern.forEach(c => pr.themes[c] = (pr.themes[c] || 0) + 1);
        if (p.personaMatch && p.personaMatch.level !== 'わからない') { s.persona.answered++; pr.pa++; if (p.personaMatch.level === '想定どおり') { s.persona.match++; pr.pm++; } }
        if (p.personaMatch) { s.persona.levels[p.personaMatch.level] = (s.persona.levels[p.personaMatch.level] || 0) + 1; p.personaMatch.gaps.forEach(g => s.persona.gaps[g] = (s.persona.gaps[g] || 0) + 1); }
        if (p.customer && p.customer.age) s.ages[p.customer.age] = (s.ages[p.customer.age] || 0) + 1;
      });
      s.pending = s.status['未確認'];
      return s;
    }
    const pct = (a, b) => b ? Math.round(a / b * 100) : 0;
    const topKey = obj => Object.entries(obj).sort((a, b) => b[1] - a[1])[0];

    // ---------- ツールチップ ----------
    const dashTip = document.createElement('div');
    dashTip.className = 'fixed z-[60] pointer-events-none hidden bg-slate-900 text-white text-[11px] leading-snug rounded-md px-2.5 py-1.5 shadow-lg max-w-[240px]';
    document.body.appendChild(dashTip);
    function showTip(html, e) { dashTip.innerHTML = html; dashTip.classList.remove('hidden'); moveTip(e); }
    function moveTip(e) { const w = dashTip.offsetWidth, h = dashTip.offsetHeight; let x = e.clientX + 14, y = e.clientY - h - 10; if (x + w > innerWidth - 8) x = e.clientX - w - 14; if (y < 8) y = e.clientY + 16; dashTip.style.left = x + 'px'; dashTip.style.top = y + 'px'; }
    function hideTip() { dashTip.classList.add('hidden'); }
    function bindTip(el, html) { el.addEventListener('mouseenter', e => showTip(html, e)); el.addEventListener('mousemove', moveTip); el.addEventListener('mouseleave', hideTip); }

    // ---------- 横棒（積み上げ）：HTMLで描く ----------
    function legendHtml(items) { return items.map(([label, color]) => `<span class="inline-flex items-center gap-1.5"><span class="w-2.5 h-2.5 rounded-sm" style="background:${color}"></span>${label}</span>`).join(''); }
    function stackedBars(container, rows, { max, onClick, compact = false } = {}) {
      // rows: [{label, segs:[{v,color,name}], total, tip, active}]
      const m = max || Math.max(1, ...rows.map(r => r.total));
      container.innerHTML = '';
      rows.forEach(r => {
        const row = document.createElement('div');
        row.className = `grid items-center gap-2 ${compact ? 'py-0.5' : 'py-1'} ${onClick ? 'cursor-pointer rounded-md hover:bg-slate-50' : ''} ${r.active ? 'bg-indigo-50' : ''}`;
        row.style.gridTemplateColumns = compact ? '5.5rem 1fr 2rem' : '7rem 1fr 2.25rem';
        const w = r.total / m * 100;
        row.innerHTML = `<span class="text-[11px] text-slate-600 truncate text-right">${esc(r.label)}</span>
          <span class="flex h-3.5" style="width:${Math.max(w, 1.5)}%; gap:2px">${r.segs.filter(s => s.v > 0).map((s, i, arr) => `<span style="flex:${s.v} 0 0; background:${s.color};${i === arr.length - 1 ? ' border-radius:0 4px 4px 0;' : ''}"></span>`).join('')}</span>
          <span class="text-[11px] font-semibold text-slate-700 tabular-nums">${r.total}</span>`;
        if (r.tip) bindTip(row, r.tip);
        if (onClick) row.addEventListener('click', () => onClick(r));
        container.appendChild(row);
      });
      if (!rows.length) container.innerHTML = '<p class="text-[11px] text-slate-400 py-4 text-center">データがありません</p>';
    }

    // ---------- フィルタの選択肢 ----------
    function fillDashFilters() {
      const posts = allDashPosts();
      const months = monthKeys(posts);
      const cur = dashState.period;
      dash.period.innerHTML = [['30', '過去30日'], ['90', '過去90日'], ...months.map(k => [k, `${+k.slice(0, 4)}年${+k.slice(5)}月`]), ['all', 'すべての期間']].map(([v, l]) => `<option value="${v}">${l}</option>`).join('');
      dash.period.value = [...dash.period.options].some(o => o.value === cur) ? cur : '30';
      dash.cat.innerHTML = `<option value="all">カテゴリ：すべて</option>` + CATALOG.map(c => `<option value="${c.id}">${esc(c.name)}</option>`).join('');
      dash.cat.value = dashState.cat;
      const stores = [...new Set(posts.map(p => p.store).filter(Boolean))].sort();
      dash.store.innerHTML = `<option value="all">店舗：すべて</option>` + stores.map(s => `<option value="${esc(s)}">${esc(s)}</option>`).join('');
      dash.store.value = stores.includes(dashState.store) ? dashState.store : 'all';
    }
    [['period', 'period'], ['cat', 'cat'], ['store', 'store'], ['outcome', 'outcome']].forEach(([el, key]) => dash[el].addEventListener('change', () => { dashState[key] = dash[el].value; renderDash(); }));
    dash.demo.addEventListener('change', () => { dashState.demo = dash.demo.checked; LS.set('rt_dash_demo', dashState.demo ? '1' : '0'); fillDashFilters(); renderDash(); });
    dash.themeChip.addEventListener('click', () => { dashState.theme = ''; renderDash(); });
    dash.rankMore.addEventListener('click', () => { dashState.rankAll = !dashState.rankAll; renderDash(); });

    // ---------- 描画 ----------
    function renderDash() {
      if (!dashReady) return;
      const all = allDashPosts();
      const range = periodRange(dashState.period);
      const posts = filterPosts(all, range);
      const prev = range.prev ? filterPosts(all, range.prev) : null;
      const s = computeStats(posts), ps = prev ? computeStats(prev) : null;
      dash.themeChip.classList.toggle('hidden', !dashState.theme);
      dash.themeChip.textContent = `テーマ：${dashState.theme} ✕`;
      renderKpis(s, ps, range);
      renderThemeChart(filterPosts(all, range, { ignoreTheme: true }));
      renderRanking(s);
      renderTrend(filterPosts(all, { start: new Date(Date.now() - 63 * DAY), end: new Date() }));
      renderPending(filterPosts(all, null).filter(p => p.status === '未確認'));
      if (!dashState.detailId || !productById(dashState.detailId)) {
        const top = Object.values(s.products).sort((a, b) => b.total - a.total)[0];
        dashState.detailId = (currentProduct && s.products[currentProduct.id]) ? currentProduct.id : top ? top.id : (currentProduct && currentProduct.id);
      }
      renderDetail(posts);
    }

    function kpiTile(label, value, sub, tone = '') {
      return `<div class="bg-white rounded-xl border border-slate-200 p-3.5 shadow-xs">
        <p class="text-[10px] font-semibold text-slate-500">${label}</p>
        <p class="text-2xl font-bold text-slate-800 tabular-nums mt-0.5">${value}</p>
        <p class="text-[10px] mt-0.5 ${tone || 'text-slate-400'}">${sub}</p></div>`;
    }
    function diffText(cur, prev, unit = '件', invert = false) {
      if (prev == null) return '';
      const d = cur - prev;
      if (d === 0) return `<span class="text-slate-400">前の期間と同じ</span>`;
      const up = d > 0;
      const good = invert ? !up : up;
      return `<span class="${good ? 'text-emerald-700' : 'text-rose-700'}">${up ? '▲' : '▼'} ${Math.abs(d)}${unit}</span><span class="text-slate-400">（前の期間比）</span>`;
    }
    function renderKpis(s, ps, range) {
      const allPending = filterPosts(allDashPosts(), null).filter(p => p.status === '未確認');
      const oldest = allPending.reduce((m, p) => Math.min(m, new Date(p.createdAt).getTime()), Date.now());
      const oldestDays = allPending.length ? Math.floor((Date.now() - oldest) / DAY) : 0;
      const handled = s.total - s.pending;
      dash.kpis.innerHTML = [
        kpiTile(`投稿数（${range.label}）`, s.total, diffText(s.total, ps && ps.total)),
        kpiTile('未確認（全期間）', allPending.length, allPending.length ? `最も古いもので ${oldestDays} 日経過` : 'すべて対応済み', oldestDays > 14 ? 'text-rose-700' : ''),
        kpiTile('対応済み', `${pct(handled, s.total)}%`, `採用 ${s.status['採用']}／検討中 ${s.status['検討中']}／見送り ${s.status['見送り']}`),
        kpiTile('買わなかった声', `${pct(s.skip, s.total)}%`, ps ? diffText(pct(s.skip, s.total), pct(ps.skip, ps.total), 'pt', true) : `${s.skip} 件`),
        kpiTile('ペルソナどおりの客層', s.persona.answered ? `${pct(s.persona.match, s.persona.answered)}%` : '—', s.persona.answered ? `回答 ${s.persona.answered} 件のうち` : 'まだ回答がありません')
      ].join('');
    }

    function renderThemeChart(posts) {
      const s = computeStats(posts);
      dash.themeLegend.innerHTML = legendHtml([['買わなかった', VIZ.skip], ['購入した', VIZ.buy], ['その他', VIZ.other]]);
      const rows = Object.entries(s.themes).sort((a, b) => b[1].total - a[1].total).map(([k, t]) => ({
        label: k, total: t.total, key: k, active: dashState.theme === k,
        segs: [{ v: t.skip, color: VIZ.skip }, { v: t.buy, color: VIZ.buy }, { v: t.other, color: VIZ.other }],
        tip: `<b>${esc(k)}</b>　${t.total} 件（延べ約 ${Math.round(t.people)} 人）<br>買わなかった ${t.skip}／購入 ${t.buy}／その他 ${t.other}`
      }));
      stackedBars(dash.themeChart, rows, { onClick: r => { dashState.theme = dashState.theme === r.key ? '' : r.key; renderDash(); } });
    }

    function renderRanking(s) {
      const list = Object.values(s.products).sort((a, b) => b.total - a.total || b.skip - a.skip);
      const shown = dashState.rankAll ? list : list.slice(0, 10);
      dash.rankMore.textContent = list.length > 10 ? (dashState.rankAll ? '上位10件に戻す' : `すべて表示（${list.length}）`) : '';
      dash.rankBody.innerHTML = shown.length ? '' : '<tr><td colspan="6" class="text-center text-slate-400 py-6">データがありません</td></tr>';
      shown.forEach(r => {
        const p = productById(r.id) || { title: '不明な製品' };
        const theme = topKey(r.themes);
        const sr = pct(r.skip, r.total);
        const tr = document.createElement('tr');
        tr.className = `border-t border-slate-100 cursor-pointer hover:bg-slate-50 ${dashState.detailId === r.id ? 'bg-indigo-50' : ''}`;
        tr.innerHTML = `
          <td class="px-3 py-1.5"><div class="flex items-center gap-2 min-w-[150px]"><img src="${p.photo || ''}" class="w-7 h-7 rounded object-contain bg-white border border-slate-200 ${p.photo ? '' : 'opacity-0'}" alt=""><span class="truncate max-w-[180px] font-semibold text-slate-700">${esc(shortName(p))}</span></div></td>
          <td class="px-2 py-1.5 text-right font-semibold tabular-nums">${r.total}</td>
          <td class="px-2 py-1.5 text-slate-600">${theme ? esc(theme[0]) + ` <span class="text-slate-400">${theme[1]}</span>` : '—'}</td>
          <td class="px-2 py-1.5"><div class="flex items-center gap-1.5"><span class="flex-1 h-2 bg-slate-100 rounded-full overflow-hidden"><span class="block h-full" style="width:${sr}%;background:${VIZ.skip};border-radius:0 4px 4px 0"></span></span><span class="tabular-nums text-slate-600 w-8 text-right">${sr}%</span></div></td>
          <td class="px-2 py-1.5 text-right tabular-nums ${r.pending ? 'text-rose-700 font-semibold' : 'text-slate-400'}">${r.pending}</td>
          <td class="px-3 py-1.5 text-right tabular-nums text-slate-600">${r.pa ? pct(r.pm, r.pa) + '%' : '—'}</td>`;
        tr.addEventListener('click', () => { dashState.detailId = r.id; renderDash(); dash.dd.root.scrollIntoView({ behavior: 'smooth', block: 'start' }); });
        dash.rankBody.appendChild(tr);
      });
    }

    function renderTrend(posts) {
      // 週ごと（月曜はじまり）。全体と「買わなかった声」の2系列
      const weeks = [];
      const now = new Date(); const monday = new Date(now); monday.setHours(0, 0, 0, 0); monday.setDate(monday.getDate() - ((monday.getDay() + 6) % 7));
      for (let i = 8; i >= 0; i--) weeks.push(new Date(monday.getTime() - i * 7 * DAY));
      const data = weeks.map(w => { const e = w.getTime() + 7 * DAY; const ps = posts.filter(p => { const t = new Date(p.createdAt).getTime(); return t >= w.getTime() && t < e; }); return { w, total: ps.length, skip: ps.filter(p => outcomeOf(p) === '見送り').length }; });
      dash.trendLegend.innerHTML = legendHtml([['すべての声', VIZ.line], ['買わなかった声', VIZ.skip]]);
      const W = 640, H = 200, L = 30, R = 12, T = 12, B = 26;
      const max = Math.max(4, ...data.map(d => d.total));
      const nice = Math.ceil(max / 4) * 4;
      const x = i => L + i * (W - L - R) / (data.length - 1);
      const y = v => T + (1 - v / nice) * (H - T - B);
      const path = key => data.map((d, i) => `${i ? 'L' : 'M'}${x(i).toFixed(1)},${y(d[key]).toFixed(1)}`).join(' ');
      const grid = [0, 1, 2, 3, 4].map(k => { const v = nice / 4 * k; return `<line x1="${L}" x2="${W - R}" y1="${y(v)}" y2="${y(v)}" stroke="#e2e8f0" stroke-width="1"/><text x="${L - 6}" y="${y(v) + 3}" text-anchor="end" font-size="10" fill="#94a3b8">${v}</text>`; }).join('');
      const labels = data.map((d, i) => `<text x="${x(i)}" y="${H - 8}" text-anchor="middle" font-size="10" fill="#94a3b8">${d.w.getMonth() + 1}/${d.w.getDate()}</text>`).join('');
      const last = data[data.length - 1];
      dash.trend.innerHTML = `<svg viewBox="0 0 ${W} ${H}" class="w-full h-auto" role="img" aria-label="週ごとの投稿数の推移">
        ${grid}${labels}
        <path d="${path('total')}" fill="none" stroke="${VIZ.line}" stroke-width="2" stroke-linejoin="round"/>
        <path d="${path('skip')}" fill="none" stroke="${VIZ.skip}" stroke-width="2" stroke-linejoin="round"/>
        ${data.map((d, i) => `<circle cx="${x(i)}" cy="${y(d.total)}" r="3" fill="${VIZ.line}" stroke="#fff" stroke-width="2"/><circle cx="${x(i)}" cy="${y(d.skip)}" r="3" fill="${VIZ.skip}" stroke="#fff" stroke-width="2"/>`).join('')}
        <text x="${x(data.length - 1) - 6}" y="${y(last.total) - 8}" text-anchor="end" font-size="10" font-weight="600" fill="#334155">${last.total}</text>
        <line id="trendCross" x1="0" x2="0" y1="${T}" y2="${H - B}" stroke="#94a3b8" stroke-width="1" stroke-dasharray="3 3" visibility="hidden"/>
        <rect x="${L}" y="${T}" width="${W - L - R}" height="${H - T - B}" fill="transparent" id="trendHit"/>
      </svg>
      <p class="text-[10px] text-slate-400 mt-1">今週（${last.w.getMonth() + 1}/${last.w.getDate()}〜）は途中までの集計です。期間フィルタに関係なく、直近9週を表示します。</p>`;
      const svg = dash.trend.querySelector('svg'), hit = svg.querySelector('#trendHit'), cross = svg.querySelector('#trendCross');
      hit.addEventListener('mousemove', e => {
        const r = svg.getBoundingClientRect(); const sx = (e.clientX - r.left) / r.width * W;
        const i = Math.max(0, Math.min(data.length - 1, Math.round((sx - L) / ((W - L - R) / (data.length - 1)))));
        cross.setAttribute('x1', x(i)); cross.setAttribute('x2', x(i)); cross.setAttribute('visibility', 'visible');
        const d = data[i]; showTip(`<b>${d.w.getMonth() + 1}/${d.w.getDate()} の週</b><br>すべての声 ${d.total} 件<br>買わなかった声 ${d.skip} 件`, e);
      });
      hit.addEventListener('mouseleave', () => { cross.setAttribute('visibility', 'hidden'); hideTip(); });
    }

    function renderPending(list) {
      list.sort((a, b) => a.createdAt.localeCompare(b.createdAt));
      dash.pendingCount.textContent = `${list.length} 件`;
      dash.pending.innerHTML = list.length ? '' : '<p class="text-[11px] text-slate-400 p-2">未対応の声はありません 🎉</p>';
      list.slice(0, 30).forEach(p => {
        const days = Math.floor((Date.now() - new Date(p.createdAt).getTime()) / DAY);
        const b = document.createElement('button');
        b.type = 'button';
        b.className = 'w-full text-left flex items-center gap-2 rounded-lg border border-slate-200 hover:border-indigo-300 px-2.5 py-1.5';
        b.innerHTML = `<span class="shrink-0 text-[10px] font-bold w-12 text-center rounded px-1 py-0.5 ${days > 14 ? 'bg-rose-100 text-rose-700' : days > 7 ? 'bg-amber-100 text-amber-800' : 'bg-slate-100 text-slate-600'}">${days}日前</span>
          <span class="min-w-0 flex-1"><span class="block text-[11px] font-semibold text-slate-700 truncate">${esc(p.ai?.summary || p.reaction.join('・'))}</span><span class="block text-[10px] text-slate-400 truncate">${esc(p.store || '')} ・ ${esc(p.author)}${p.demo ? ' ・ デモ' : ''}</span></span>`;
        b.addEventListener('click', () => {
          const r = periodRange(dashState.period), t = new Date(p.createdAt);
          if (t < r.start || t > r.end || (dashState.theme && !p.concern.includes(dashState.theme)) || (dashState.outcome !== 'all' && outcomeOf(p) !== dashState.outcome)) {
            Object.assign(dashState, { period: 'all', theme: '', outcome: 'all' });
            dash.period.value = 'all'; dash.outcome.value = 'all';
            showToast('この声が見えるよう、期間を「すべて」に切り替えました');
          }
          dash.dd.voiceFilter.value = 'all';
          dashState.detailId = p.productId; dashState.openVoice = p.id; renderDash(); dash.dd.root.scrollIntoView({ behavior: 'smooth', block: 'start' });
        });
        dash.pending.appendChild(b);
      });
    }

    // ---------- 製品詳細 ----------
    function renderDetail(periodPosts) {
      const id = dashState.detailId;
      const p = id ? productById(id) : null;
      const d = dash.dd;
      if (!p) { d.root.classList.add('hidden'); return; }
      d.root.classList.remove('hidden');
      const posts = periodPosts.filter(x => x.productId === id);
      const s = computeStats(posts);
      d.thumb.src = p.photo || '';
      d.title.textContent = p.title;
      d.meta.textContent = `${periodRange(dashState.period).label}：${s.total} 件 ・ 買わなかった ${pct(s.skip, s.total)}% ・ 未確認 ${s.pending} 件${dashState.theme ? ' ・ テーマ「' + dashState.theme + '」で絞り込み中' : ''}`;
      d.empty.classList.toggle('hidden', posts.length > 0);
      d.body.classList.toggle('hidden', posts.length === 0);
      if (!posts.length) return;

      // ピンマップ
      const pins = posts.flatMap(x => x.pinSource === 'photo' || !x.pinSource ? x.pins : []);
      d.pinImg.onload = () => drawPinHeat(pins);
      d.pinImg.src = p.photo || '';
      if (d.pinImg.complete) drawPinHeat(pins);
      const parts = {}; pins.forEach(x => { const k = x.part || '部位未選択'; parts[k] = (parts[k] || 0) + 1; });
      d.pinParts.innerHTML = pins.length ? `<p class="text-[10px] text-slate-500">ピン ${pins.length} か所（実物写真に付けたもの）</p>` + Object.entries(parts).sort((a, b) => b[1] - a[1]).map(([k, n]) => `<div class="flex items-center gap-2 text-[11px]"><span class="w-20 text-slate-600 truncate">${esc(k)}</span><span class="flex-1 h-2 bg-slate-100 rounded-full overflow-hidden"><span class="block h-full" style="width:${pct(n, pins.length)}%;background:#e34948;border-radius:0 4px 4px 0"></span></span><span class="w-6 text-right tabular-nums font-semibold text-slate-700">${n}</span></div>`).join('') : '<p class="text-[11px] text-slate-400">ピンの付いた声はまだありません</p>';

      // テーマ内訳
      stackedBars(d.theme, Object.entries(s.themes).sort((a, b) => b[1].total - a[1].total).map(([k, t]) => ({
        label: k, total: t.total, segs: [{ v: t.skip, color: VIZ.skip }, { v: t.buy, color: VIZ.buy }, { v: t.other, color: VIZ.other }],
        tip: `<b>${esc(k)}</b> ${t.total} 件<br>買わなかった ${t.skip}／購入した ${t.buy}／その他 ${t.other}`
      })), { compact: true });
      // 年代
      const AGE_ORDER = ['10代', '20代', '30代', '40代', '50代', '60代以上'];
      stackedBars(d.age, AGE_ORDER.filter(a => s.ages[a]).map(a => ({ label: a, total: s.ages[a], segs: [{ v: s.ages[a], color: VIZ.line }], tip: `${a}：${s.ages[a]} 件` })), { compact: true });

      // ペルソナ
      const persona = getPersona(id).trim();
      d.personaText.textContent = persona || 'まだ記入されていません（「精密言語化・解析」タブで記入できます）';
      const lv = s.persona.levels; const lvTotal = Object.values(lv).reduce((a, b) => a + b, 0);
      d.personaBar.innerHTML = lvTotal ? `
        <div class="flex h-4 w-full" style="gap:2px">${['想定どおり', '一部ちがう', 'ちがう', 'わからない'].filter(k => lv[k]).map((k, i, arr) => `<span class="pbar" data-k="${k}" style="flex:${lv[k]} 0 0;background:${VIZ.persona[k]};${i === arr.length - 1 ? 'border-radius:0 4px 4px 0' : ''}"></span>`).join('')}</div>
        <div class="flex flex-wrap gap-x-3 gap-y-1 mt-1.5 text-[10px] text-slate-600">${['想定どおり', '一部ちがう', 'ちがう', 'わからない'].filter(k => lv[k]).map(k => `<span class="inline-flex items-center gap-1"><span class="w-2.5 h-2.5 rounded-sm" style="background:${VIZ.persona[k]}"></span>${k} ${lv[k]}</span>`).join('')}</div>` : '<p class="text-[11px] text-slate-400">ペルソナ照合の回答はまだありません</p>';
      d.personaBar.querySelectorAll('.pbar').forEach(el => bindTip(el, `${el.dataset.k}：${lv[el.dataset.k]} 件（${pct(lv[el.dataset.k], lvTotal)}%）`));
      const gaps = Object.entries(s.persona.gaps).sort((a, b) => b[1] - a[1]);
      d.personaGaps.innerHTML = gaps.length ? `<p class="text-[10px] text-slate-500">ずれていた項目</p>` + gaps.map(([k, n]) => `<p class="text-[11px] text-slate-700">・${esc(k)} <b class="tabular-nums">${n}</b> 件</p>`).join('') +
        [...new Set(posts.filter(x => x.personaMatch && x.personaMatch.note).map(x => x.personaMatch.note))].slice(0, 2).map(n => `<p class="text-[11px] text-violet-900 bg-violet-50 rounded px-2 py-1">「${esc(n)}」</p>`).join('') : '';

      renderVoices(posts);
