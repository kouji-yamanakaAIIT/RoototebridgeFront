            <div class="rounded-lg border border-slate-200 p-3"><p class="text-[10px] text-slate-500">ペルソナどおりの客層</p><p class="text-2xl font-bold tabular-nums">${s.persona.answered ? pct(s.persona.match, s.persona.answered) + '<span class="text-sm font-semibold"> %</span>' : '—'}</p><p class="text-[10px] text-slate-500">回答 ${s.persona.answered} 件</p></div>
