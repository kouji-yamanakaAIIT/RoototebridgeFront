        const on = multi ? fbState[key].includes(v) : fbState[key] === v;
        const b = document.createElement('button');
        b.type = 'button';
        b.className = `fb-chip ${color} ${on ? 'on' : ''}`;
        b.textContent = v;
        b.setAttribute('aria-pressed', on);
        b.addEventListener('click', () => {
