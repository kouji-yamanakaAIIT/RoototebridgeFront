    function drawPinHeat(pins) {
      const img = dash.dd.pinImg, c = dash.dd.pinCanvas;
      const w = img.clientWidth, h = img.clientHeight;
      if (!w || !h) return;
      const dpr = window.devicePixelRatio || 1;
      c.width = w * dpr; c.height = h * dpr;
      const ctx = c.getContext('2d');
      ctx.scale(dpr, dpr);
      ctx.clearRect(0, 0, w, h);
      const r = Math.max(14, w * 0.07);
      pins.forEach(p => {
        const x = p.x / 100 * w, y = p.y / 100 * h;
        const g = ctx.createRadialGradient(x, y, 0, x, y, r);
        g.addColorStop(0, 'rgba(227,73,72,0.45)'); g.addColorStop(1, 'rgba(227,73,72,0)');
        ctx.fillStyle = g; ctx.beginPath(); ctx.arc(x, y, r, 0, Math.PI * 2); ctx.fill();
      });
      pins.forEach(p => { ctx.beginPath(); ctx.arc(p.x / 100 * w, p.y / 100 * h, 2.5, 0, Math.PI * 2); ctx.fillStyle = '#b91c1c'; ctx.fill(); });
    }
