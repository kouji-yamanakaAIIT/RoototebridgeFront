      let lastId = null;
      for (const f of files) {
        if (!f.type.startsWith('image/')) continue;
        try {
          const src = await resizeToJpeg(f);
          lastId = 'x' + Date.now().toString(36) + Math.random().toString(36).slice(2, 6);
          const label = (f.name || '追加写真').replace(/\.[^.]+$/, '').slice(0, 14);
          list.push({ id: lastId, label, src });
        } catch (e) { showToast('読み込めない画像がありました'); }
      }
      if (!lastId) return;
      await IDB.set('rt_photos_' + p.id, list);
      LS.set('rt_photo_sel_' + p.id, lastId);
      if (currentProduct === p) await loadPhotos(p);
      if (p.custom) renderSidebar();
      showToast('写真を追加し、言語化に使う画像に設定しました');
    }

