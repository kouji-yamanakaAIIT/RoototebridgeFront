        pinSource: fbState.pinSourceKey, pinImage: fbState.pins.length ? await pinnedImageDataUrl() : '',
        pins: fbState.pins.map(x => ({ ...x })),
        reaction: [...fbState.reaction], concern: [...fbState.concern], count: fbState.count,
        customer: { age: fbState.age, gender: fbState.gender, with: fbState.with },
        text: fb.text.value.trim(), photos: [...fbState.photos],
        personaMatch: fbState.persona ? { level: fbState.persona, gaps: [...fbState.personaGap], note: fb.personaNote.value.trim() } : null,
        requestId: fbState.requestId,
