<!DOCTYPE html>
<html lang="ja" class="h-full">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>ROOTOTE ブリッジ（営業用）</title>
  <!-- Tailwind CSS CDN -->
  <script src="https://cdn.tailwindcss.com"></script>
  <!-- Marked.js for Markdown parsing -->
  <script src="https://cdn.jsdelivr.net/npm/marked/marked.min.js"></script>
  <style>
    .drag-active {
      border-color: #6366f1 !important;
      background-color: #eef2ff !important;
    }
    .markdown-body h2 {
      font-size: 1.15rem;
      font-weight: 700;
      margin-top: 1.35rem;
      margin-bottom: 0.5rem;
      border-bottom: 2px solid #e2e8f0;
      padding-bottom: 0.35rem;
      color: #1e293b;
    }
    .markdown-body h3 {
      font-size: 1rem;
      font-weight: 600;
      margin-top: 1rem;
      margin-bottom: 0.35rem;
      color: #334155;
    }
    .markdown-body p {
      margin-bottom: 0.75rem;
      line-height: 1.7;
    }
    .markdown-body ul, .markdown-body ol {
      margin-left: 1.25rem;
      margin-bottom: 0.75rem;
      list-style-type: disc;
    }
    .markdown-body li {
      margin-bottom: 0.3rem;
    }
    .markdown-body code {
      background-color: #f1f5f9;
      color: #0f172a;
      padding: 0.15rem 0.35rem;
      border-radius: 0.25rem;
      font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
      font-size: 0.88em;
    }
    .markdown-body pre {
      background-color: #0f172a;
      color: #f8fafc;
      padding: 0.85rem 1rem;
      border-radius: 0.5rem;
      overflow-x: auto;
      margin-bottom: 0.85rem;
    }
    .markdown-body pre code {
      background-color: transparent;
      color: inherit;
      padding: 0;
    }
    .markdown-body table { width: 100%; border-collapse: collapse; margin: 0.5rem 0 1rem; font-size: 0.85rem; }
    .markdown-body th, .markdown-body td { border: 1px solid #e2e8f0; padding: 0.4rem 0.6rem; text-align: left; vertical-align: top; }
    .markdown-body th { background: #f8fafc; font-weight: 600; color: #334155; }
    .markdown-body blockquote { border-left: 3px solid #c4b5fd; padding-left: 0.75rem; color: #475569; margin: 0.5rem 0 0.9rem; }
    .preset-chip.active {
      background-color: #4f46e5 !important;
      color: #ffffff !important;
      border-color: #4f46e5 !important;
      box-shadow: 0 1px 3px 0 rgba(79, 70, 229, 0.3);
    }
    .prompt-card {
      transition: transform 0.15s ease, box-shadow 0.15s ease;
    }
    .prompt-card:hover {
      box-shadow: 0 8px 20px -4px rgba(0, 0, 0, 0.08);
    }

    /* ===== 現場の声（営業フィードバック） ===== */
    .fb-chip { font-size: 11px; padding: .32rem .7rem; border-radius: 9999px; border: 1px solid #e2e8f0; background: #fff; color: #334155; transition: background .12s, border-color .12s; line-height: 1.2; }
    .fb-chip:hover { border-color: #a5b4fc; background: #eef2ff; }
    .fb-chip.on { background: #4f46e5; border-color: #4f46e5; color: #fff; }
    .fb-chip.violet.on { background: #7c3aed; border-color: #7c3aed; }
    .fb-chip.rose.on { background: #e11d48; border-color: #e11d48; }
    .fb-chip.emerald.on { background: #059669; border-color: #059669; }
    .fb-badge { display: inline-flex; min-width: 16px; height: 16px; padding: 0 4px; border-radius: 9999px; background: #ef4444; color: #fff; font-size: 10px; align-items: center; justify-content: center; font-weight: 700; vertical-align: middle; }
    .fb-badge.hidden { display: none; }
    .fb-grid { display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(0, .9fr); gap: 1.25rem; align-items: start; }
    .fb-mtabs, .fb-bottombar { display: none; }
    .fb-side-sticky { position: sticky; top: 1rem; }
    .fb-pin { position: absolute; width: 24px; height: 24px; margin: -12px 0 0 -12px; border-radius: 9999px; background: #e11d48; color: #fff; font-size: 11px; font-weight: 700; display: flex; align-items: center; justify-content: center; border: 2px solid #fff; box-shadow: 0 2px 6px rgba(0,0,0,.35); pointer-events: none; }
    .fb-root.fb-force-mobile { max-width: 390px; margin: 0 auto; border: 12px solid #0f172a; border-radius: 2.25rem; height: 800px; overflow-y: auto; background: #f1f5f9; padding: .6rem .6rem 0; }
    body[data-app="sales"] .studio-only, body[data-app="sales"] .designer-only { display: none !important; }
    @media (max-width: 1023px) {

    .fb-root .fb-grid { grid-template-columns: minmax(0, 1fr); gap: 1rem; }
    .fb-root .fb-mtabs { display: flex; gap: .25rem; background: #fff; border: 1px solid #e2e8f0; border-radius: .75rem; padding: .25rem; margin-bottom: .75rem; position: sticky; top: 0; z-index: 10; box-shadow: 0 1px 2px rgba(0,0,0,.04); }
    .fb-root .fb-mtab { flex: 1; font-size: 12px; font-weight: 600; padding: .55rem .25rem; border-radius: .5rem; color: #475569; }
    .fb-root .fb-mtab.active { background: #4f46e5; color: #fff; }
    .fb-root [data-fb-panel]:not(.fb-show) { display: none !important; }
    .fb-root .fb-side-sticky { position: static; }
    .fb-root .fb-ai-actions { display: none; }
    .fb-root.fb-tab-input .fb-bottombar { display: flex; gap: .5rem; position: sticky; bottom: 0; background: rgba(255,255,255,.96); backdrop-filter: blur(6px); padding: .6rem; border-top: 1px solid #e2e8f0; margin: 1rem -.6rem 0; z-index: 10; }
    body.fb-tab-active #productSidebar, body[data-app="sales"] #productSidebar { display: none; }
    }

    .fb-root.fb-force-mobile .fb-grid { grid-template-columns: minmax(0, 1fr); gap: 1rem; }
    .fb-root.fb-force-mobile .fb-mtabs { display: flex; gap: .25rem; background: #fff; border: 1px solid #e2e8f0; border-radius: .75rem; padding: .25rem; margin-bottom: .75rem; position: sticky; top: 0; z-index: 10; box-shadow: 0 1px 2px rgba(0,0,0,.04); }
    .fb-root.fb-force-mobile .fb-mtab { flex: 1; font-size: 12px; font-weight: 600; padding: .55rem .25rem; border-radius: .5rem; color: #475569; }
    .fb-root.fb-force-mobile .fb-mtab.active { background: #4f46e5; color: #fff; }
    .fb-root.fb-force-mobile [data-fb-panel]:not(.fb-show) { display: none !important; }
    .fb-root.fb-force-mobile .fb-side-sticky { position: static; }
    .fb-root.fb-force-mobile .fb-ai-actions { display: none; }
    .fb-root.fb-force-mobile.fb-tab-input .fb-bottombar { display: flex; gap: .5rem; position: sticky; bottom: 0; background: rgba(255,255,255,.96); backdrop-filter: blur(6px); padding: .6rem; border-top: 1px solid #e2e8f0; margin: 1rem -.6rem 0; z-index: 10; }

    .dash-select { font-size: 11px; border: 1px solid #e2e8f0; border-radius: .5rem; padding: .35rem .5rem; background: #fff; color: #334155; }
    .rep-h2 { font-size: 14px; font-weight: 700; border-left: 4px solid #4f46e5; padding-left: .5rem; margin-bottom: .6rem; }
    @media print {
      body.report-open > *:not(#reportOverlay) { display: none !important; }
      body.report-open #reportOverlay { position: static; background: none; padding: 0; overflow: visible; display: block !important; }
      .report-toolbar { display: none !important; }
      .report-sheet { box-shadow: none !important; max-width: none !important; border-radius: 0 !important; padding: 0 !important; }
      body { background: #fff !important; }
      * { -webkit-print-color-adjust: exact; print-color-adjust: exact; }
      .rep-h2 { break-after: avoid; }
      section, blockquote, tr { break-inside: avoid; }
    }
  </style>
</head>
<body data-app="sales" class="bg-slate-100 text-slate-800 min-h-full flex flex-col font-sans antialiased">

  <!-- ヘッダー（タイトル＆APIキー管理のみに簡素化） -->
  <header class="bg-white border-b border-slate-200 px-4 sm:px-6 py-3 flex flex-wrap items-center justify-between gap-3 shrink-0 shadow-xs z-20">
    <div class="flex items-center gap-3">
      <div class="w-9 h-9 rounded-xl bg-gradient-to-br from-indigo-600 to-violet-600 flex items-center justify-center text-white shadow font-bold text-lg select-none">
        👜
      </div>
      <div>
        <h1 class="text-sm sm:text-base font-bold text-slate-800 leading-tight">ROOTOTE ブリッジ <span class="ml-1 align-middle text-[10px] font-semibold px-1.5 py-0.5 rounded bg-sky-100 text-sky-700">営業用</span></h1>
        <p class="text-[11px] text-slate-500 hidden sm:block">売り場の反応を30秒でデザイナーへ</p>
      </div>
    </div>

    <!-- APIキー設定エリア -->
    <div class="flex items-center gap-2">
      <div class="relative">
        <input type="password" id="apiKeyInput" placeholder="Gemini API Key（環境設定時は空欄で可）" 
               class="border border-slate-300 rounded-lg px-3 py-1.5 text-xs w-48 sm:w-60 focus:outline-none focus:ring-2 focus:ring-indigo-500 bg-slate-50 focus:bg-white transition">
        <button id="toggleKeyVisibility" type="button" class="absolute right-2.5 top-1/2 -translate-y-1/2 text-slate-400 hover:text-slate-600 text-xs" title="表示切り替え">
          👁
        </button>
      </div>
      <button id="saveKeyBtn" type="button" class="bg-slate-700 hover:bg-slate-800 text-white text-xs font-medium px-3 py-1.5 rounded-lg transition shadow-xs">
        保存
      </button>
      <span id="keyStatus" class="text-[11px] text-emerald-600 font-medium hidden">✓ 設定済</span>
    </div>
  </header>

  <!-- 内部フレーム・メインコンテナ -->
  <div class="flex-1 max-w-[1600px] w-full mx-auto p-3 sm:p-5 flex flex-col lg:flex-row gap-4">
    <!-- 左サイドバー: 製品メニュー -->
    <aside id="productSidebar" class="w-full lg:w-72 shrink-0 bg-white rounded-xl border border-slate-200 shadow-xs flex flex-col lg:sticky lg:top-4 max-h-[55vh] lg:max-h-[calc(100vh-6.5rem)] lg:self-start">
      <div class="p-3 border-b border-slate-100 space-y-2">
        <div class="flex items-center justify-between">
          <span class="text-xs font-bold uppercase tracking-wider text-slate-500">製品メニュー</span>
          <span id="productCount" class="text-[11px] text-slate-400"></span>
        </div>
        <div class="relative">
          <input id="productSearch" type="search" placeholder="製品名・品番・タグで絞り込み"
                 class="w-full border border-slate-300 rounded-lg pl-7 pr-2 py-1.5 text-xs bg-slate-50 focus:bg-white focus:outline-none focus:ring-2 focus:ring-indigo-500">
          <span class="absolute left-2.5 top-1/2 -translate-y-1/2 text-slate-400 text-xs">🔍</span>
        </div>
      </div>
      <nav id="categoryList" class="flex-1 overflow-y-auto p-2 space-y-1" aria-label="製品カテゴリ"></nav>
      <div class="p-3 border-t border-slate-100 space-y-1.5">
        <button id="addProductBtn" type="button" class="w-full py-2 text-xs font-semibold rounded-lg border border-dashed border-indigo-300 text-indigo-700 bg-indigo-50/50 hover:bg-indigo-50 transition">
          ＋ 画像から製品を追加
        </button>
        <p class="text-[10px] text-slate-400 leading-snug">追加した製品・写真・ペルソナは、このブラウザの中にだけ保存されます。</p>
      </div>
    </aside>

    <!-- 右側: タブ＋各ビュー -->
    <div class="flex-1 min-w-0 flex flex-col gap-4">


    <!-- 内部フレーム配置：主要タブナビゲーション（iframe内でも確実に動作） -->
    <div class="studio-only bg-white border border-slate-200 rounded-xl p-1.5 shadow-xs flex flex-wrap items-center justify-between gap-2">
      <nav class="flex items-center gap-1.5 w-full xl:w-auto overflow-x-auto" role="tablist">
        <button id="tabBreakdownBtn" type="button" role="tab" aria-selected="true"
                class="tab-nav-btn shrink-0 whitespace-nowrap px-4 py-2 rounded-lg text-xs sm:text-sm font-bold transition flex items-center justify-center gap-2 bg-indigo-600 text-white shadow-xs">
          <span>🔍</span>
          <span>精密言語化・解析</span>
        </button>
        <button id="tabArrangerBtn" type="button" role="tab" aria-selected="false"
                class="tab-nav-btn shrink-0 whitespace-nowrap px-4 py-2 rounded-lg text-xs sm:text-sm font-semibold transition flex items-center justify-center gap-2 text-slate-600 hover:text-slate-900 hover:bg-slate-100">
          <span>🎨</span>
          <span>デザインアレンジャー & プレビュー</span>
          <span class="px-1.5 py-0.2 bg-amber-100 text-amber-800 text-[10px] rounded-full font-bold">New</span>
        </button>
        <button id="tabFeedbackBtn" type="button" role="tab" aria-selected="false"
                class="tab-nav-btn shrink-0 whitespace-nowrap px-4 py-2 rounded-lg text-xs sm:text-sm font-semibold transition flex items-center justify-center gap-2 text-slate-600 hover:text-slate-900 hover:bg-slate-100">
          <span>🗣️</span>
          <span>現場の声（営業→デザイナー）</span>
          <span class="fb-post-badge fb-badge hidden"></span>
        </button>
        <button id="tabDashBtn" type="button" role="tab" aria-selected="false"
                class="tab-nav-btn shrink-0 whitespace-nowrap px-4 py-2 rounded-lg text-xs sm:text-sm font-semibold transition flex items-center justify-center gap-2 text-slate-600 hover:text-slate-900 hover:bg-slate-100">
          <span>📊</span>
          <span>声の集計（デザイナー）</span>
        </button>
      </nav>

      <div class="hidden md:flex items-center gap-2 text-xs text-slate-400 font-medium pr-2">
        <span class="w-2 h-2 rounded-full bg-emerald-500 inline-block"></span>
        <span>内部フレーム同期中</span>
      </div>
    </div>

    <!-- タブ 1: 精密言語化・仕様解析ビュー -->
    <main id="tabBreakdownView" class="grid grid-cols-1 xl:grid-cols-12 gap-5 w-full">

      <!-- 中央カラム: 選んだ製品・ペルソナ・言語化モード -->
      <div class="xl:col-span-5 flex flex-col gap-4">

        <!-- 製品カード -->
        <section class="bg-white rounded-xl border border-slate-200 p-4 shadow-xs space-y-3">
          <div>
            <div class="flex flex-wrap items-center gap-1.5 mb-1.5">
              <span id="pCat" class="px-2 py-0.5 rounded-full bg-indigo-50 text-indigo-700 text-[10px] font-bold"></span>
              <span id="pNo" class="px-2 py-0.5 rounded-full bg-slate-100 text-slate-600 text-[10px] font-mono font-semibold"></span>
              <span id="pBadge" class="px-2 py-0.5 rounded-full bg-amber-50 text-amber-800 text-[10px] font-semibold"></span>
            </div>
            <h2 id="pTitle" class="text-sm sm:text-base font-bold text-slate-800 leading-snug">製品を選んでください</h2>
            <p id="pMeta" class="text-[11px] text-slate-500 mt-0.5"></p>
            <div id="pCustomActions" class="hidden mt-2 flex items-center gap-2">
              <span class="text-[10px] px-2 py-0.5 rounded-full bg-emerald-50 text-emerald-700 font-semibold">カタログ外（追加した製品）</span>
              <button id="deleteProductBtn" type="button" class="text-[11px] text-rose-600 hover:text-rose-800 underline">この製品を削除</button>
            </div>
          </div>

          <!-- 言語化に使う画像（ドラッグ＆ドロップで写真を追加） -->
          <div id="dropZone" class="border-2 border-dashed border-slate-200 hover:border-indigo-400 rounded-xl p-3 text-center cursor-pointer transition flex flex-col items-center justify-center min-h-[220px] bg-slate-50 relative group">
            <input type="file" id="fileInput" accept="image/*" multiple class="hidden">
            <span class="absolute top-2 left-2 text-[10px] font-semibold text-slate-500 bg-white/90 border border-slate-200 rounded-md px-1.5 py-0.5">言語化に使う画像</span>
            <div id="uploadPlaceholder" class="space-y-2">
              <div class="w-11 h-11 mx-auto rounded-full bg-indigo-50 text-indigo-600 flex items-center justify-center text-xl shadow-xs">📷</div>
              <p class="text-xs font-semibold text-slate-700">写真をドラッグ＆ドロップ</p>
              <p class="text-[11px] text-slate-400">または <span class="text-indigo-600 underline font-medium">ファイルを選択</span>（PNG, JPG, WEBP）</p>
            </div>
            <div id="previewWrapper" class="hidden w-full flex flex-col items-center">
              <img id="previewImg" class="max-h-60 max-w-full object-contain rounded-lg bg-white" alt="言語化に使う画像">
              <p class="text-[10px] text-slate-400 mt-1.5">ここに写真をドロップすると、この製品に写真を追加できます</p>
            </div>
          </div>

          <!-- 写真の切り替え・追加 -->
          <div>
            <div id="photoStrip" class="flex gap-2 overflow-x-auto pb-1"></div>
            <p class="text-[10px] text-slate-400 mt-1 leading-snug">サムネイルを選ぶと言語化に使う画像が切り替わります。「📷 追加」で新色・別アングル・サンプル写真を足せます。</p>
          </div>

          <!-- カタログの確定データ -->
          <details id="pSpecDetails" class="group rounded-lg border border-slate-200 bg-slate-50/60" open>
            <summary class="cursor-pointer select-none px-3 py-2 text-xs font-semibold text-slate-600 flex items-center justify-between">
              <span>📘 カタログの確定データ</span>
              <span class="text-[10px] text-slate-400 font-normal">言語化のときAIに渡します</span>
            </summary>
            <div class="px-3 pb-3 space-y-2">
              <table class="w-full text-[11px]"><tbody id="pSpecs"></tbody></table>
              <div id="pTags" class="flex flex-wrap gap-1"></div>
              <p id="pDesc" class="text-[11px] text-slate-600 leading-relaxed"></p>
              <p id="pSource" class="text-[10px] text-slate-400 break-all"></p>
            </div>
          </details>
        </section>

        <!-- 設計ペルソナ -->
        <section class="bg-white rounded-xl border border-slate-200 p-4 shadow-xs space-y-2">
          <div class="flex items-center justify-between gap-2">
            <label for="personaInput" class="text-xs font-semibold uppercase tracking-wider text-slate-500">👤 設計ペルソナ（デザイナー記入）</label>
            <button id="personaExampleBtn" type="button" class="text-[11px] text-indigo-600 hover:text-indigo-800 underline shrink-0">記入例を入れる</button>
          </div>
          <textarea id="personaInput" rows="7"
            class="w-full border border-slate-300 rounded-lg px-3 py-2 text-xs leading-relaxed focus:outline-none focus:ring-2 focus:ring-indigo-500 bg-slate-50 focus:bg-white resize-y"
            placeholder="この製品を「誰の」「どんな場面の」「どんな困りごと」のために設計したかを書いてください。&#10;例：保育園の送迎のあと電車で通勤する30代。片手がふさがりがちで、バッグの中で鍵やICカードが迷子になる…"></textarea>
          <div class="flex items-center justify-between text-[10px] text-slate-400">
            <span id="personaSavedNote">製品ごとにこのブラウザへ自動保存されます</span>
            <span id="personaCharCount">0 字</span>
          </div>
        </section>

        <!-- 言語化モード切り替え & 実行 -->
        <section class="bg-white rounded-xl border border-slate-200 p-4 shadow-xs space-y-3">
          <label class="block text-xs font-semibold uppercase tracking-wider text-slate-500">言語化モードを選択</label>
          <div class="grid grid-cols-2 gap-2">
            <button type="button" class="mode-btn p-3 rounded-lg border text-left transition border-slate-200 bg-white text-slate-700 hover:bg-slate-50" data-mode="spec">
              <div class="font-bold text-xs flex items-center gap-1.5"><span>📋</span> 製品仕様書</div>
              <div class="text-[11px] text-slate-500 mt-0.5 leading-snug">形状・素材・機能＋設計意図</div>
              <span class="persona-chip inline-block mt-1 text-[10px] px-1.5 py-0.5 rounded bg-violet-50 text-violet-700 font-semibold">👤 ペルソナ反映可</span>
            </button>
            <button type="button" class="mode-btn p-3 rounded-lg border text-left transition border-slate-200 bg-white text-slate-700 hover:bg-slate-50" data-mode="ec">
              <div class="font-bold text-xs flex items-center gap-1.5"><span>🏷️</span> EC出品・商品説明</div>
              <div class="text-[11px] text-slate-500 mt-0.5 leading-snug">キャッチコピー・本文・スペック</div>
              <span class="persona-chip inline-block mt-1 text-[10px] px-1.5 py-0.5 rounded bg-violet-50 text-violet-700 font-semibold">👤 ペルソナ反映可</span>
            </button>
            <button type="button" class="mode-btn p-3 rounded-lg border text-left transition border-slate-200 bg-white text-slate-700 hover:bg-slate-50" data-mode="prompt">
              <div class="font-bold text-xs flex items-center gap-1.5"><span>🎨</span> 画像生成プロンプト</div>
              <div class="text-[11px] text-slate-500 mt-0.5 leading-snug">英語＆日本語（各1本特大表示）</div>
            </button>
            <button type="button" class="mode-btn p-3 rounded-lg border text-left transition border-slate-200 bg-white text-slate-700 hover:bg-slate-50" data-mode="alt">
              <div class="font-bold text-xs flex items-center gap-1.5"><span>🔍</span> 忠実な外観記述</div>
              <div class="text-[11px] text-slate-500 mt-0.5 leading-snug">客観的・網羅的な視覚文章</div>
            </button>
            <button type="button" class="mode-btn col-span-2 p-3 rounded-lg border text-left transition border-slate-200 bg-white text-slate-700 hover:bg-slate-50" data-mode="talk">
