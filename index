              <p class="text-xs font-semibold text-slate-800 leading-snug mt-1">${esc(ai.summary || post.reaction.join('・'))}</p>
              <p class="text-[10px] text-slate-400 mt-0.5 truncate">${esc(post.author)}${post.store ? ' ・ ' + esc(post.store) : ''} ・ ${fmtDate(post.createdAt)} ・ ${esc(shortName({ title: post.productTitle }))}</p>
              ${post.statusReason ? `<p class="mt-1.5 text-[11px] rounded-md px-2 py-1 ${STATUS_STYLE[post.status] || ''}"><b>デザイナー：</b>${esc(post.statusReason)}</p>` : ''}
