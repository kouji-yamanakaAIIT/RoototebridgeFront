            ${post.text ? `<p class="text-[11px] text-slate-600"><b class="text-slate-500">生の言葉：</b>${esc(post.text)}</p>` : ''}
            ${post.photos && post.photos.length ? `<div class="flex gap-1.5">${post.photos.map(src => `<img src="${src}" class="w-16 h-16 rounded-md object-cover border border-slate-200" alt="売り場写真">`).join('')}</div>` : ''}
            <div class="designer-only rounded-lg border border-slate-200 bg-slate-50 p-2.5 space-y-2">
              <p class="text-[10px] font-bold text-slate-500">デザイナーの対応（ここで更新すると営業に通知されます）</p>
              <div class="flex flex-wrap gap-1.5 fb-status-chips">${FB_OPTS.status.map(s => `<button type="button" data-status="${s}" class="fb-chip ${post.status === s ? 'on' : ''}">${s}</button>`).join('')}</div>
              <input type="text" class="fb-status-reason w-full border border-slate-300 rounded-md px-2 py-1.5 text-[11px] bg-white" placeholder="理由（例：次期モデルで重量を見直す案に入れました）" value="${esc(post.statusReason)}">
              <div class="flex justify-between items-center">
                <button type="button" class="fb-del text-[10px] text-rose-600 underline">この投稿を削除</button>
                <button type="button" class="fb-status-save text-[11px] font-semibold px-3 py-1 rounded-md bg-slate-800 text-white">対応を保存</button>
              </div>
            </div>
          </div>`;
        const body = d.querySelector('.fb-post-body');
        d.querySelector('.fb-post-head').addEventListener('click', async () => {
          const opening = body.classList.contains('hidden');
          body.classList.toggle('hidden');
          if (opening) {
            renderAiResult(body.querySelector('.fb-post-ai'), { ...ai, follow_up: (ai.follow_up || []).filter(q => q.answer) }, false);
            if (!post.seen) { post.seen = true; await IDB.set('rt_fb_posts', fbPosts); renderPostsBadgeOnly(); d.classList.remove('border-amber-300', 'ring-2', 'ring-amber-100'); }
          }
        });
        let pendingStatus = post.status;
        d.querySelectorAll('[data-status]').forEach(b => b.addEventListener('click', () => {
          pendingStatus = b.dataset.status;
          d.querySelectorAll('[data-status]').forEach(x => x.classList.toggle('on', x.dataset.status === pendingStatus));
        }));
        d.querySelector('.fb-status-save').addEventListener('click', async () => {
          post.status = pendingStatus;
          post.statusReason = d.querySelector('.fb-status-reason').value.trim();
          post.statusAt = new Date().toISOString();
          post.seen = false;   // 営業側に「更新されました」を出す
          await IDB.set('rt_fb_posts', fbPosts);
          renderPosts();
          showToast(`「${post.status}」で保存しました（営業に通知）`);
        });
        let delArmed = false;
        d.querySelector('.fb-del').addEventListener('click', async (e) => {
          if (!delArmed) { delArmed = true; e.target.textContent = 'もう一度押すと削除'; return; }
          fbPosts = fbPosts.filter(x => x.id !== post.id);
          fbRequests.forEach(r => { r.answers = (r.answers || []).filter(a => a !== post.id); });
          await IDB.set('rt_fb_posts', fbPosts); await IDB.set('rt_fb_requests', fbRequests);
          renderPosts(); renderRequests();
        });
        fb.postList.appendChild(d);
      });
    }
    function renderPostsBadgeOnly() {
      const unseen = fbPosts.filter(x => !x.seen).length;
      document.querySelectorAll('.fb-post-badge').forEach(b => { b.textContent = unseen; b.classList.toggle('hidden', !unseen); });
    }
    fb.postFilter.addEventListener('change', renderPosts);

    document.getElementById('fbExportBtn').addEventListener('click', () => {
      const blob = new Blob([JSON.stringify({ type: 'rootote-field-voices', exportedAt: new Date().toISOString(), posts: fbPosts, requests: fbRequests }, null, 1)], { type: 'application/json' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url; a.download = `rootote-現場の声-${new Date().toISOString().slice(0, 10)}.json`; a.click();
      URL.revokeObjectURL(url);
    });
    document.getElementById('fbImportInput').addEventListener('change', async (e) => {
      const f = e.target.files[0];
      e.target.value = '';
      if (!f) return;
      try {
        const data = JSON.parse(await f.text());
        if (data.type !== 'rootote-field-voices') throw new Error('形式が違います');
        const ids = new Set(fbPosts.map(x => x.id));
        const added = (data.posts || []).filter(x => !ids.has(x.id));
        // 既存の投稿は対応状況だけ取り込む（新しい方を採用）
        (data.posts || []).forEach(x => {
          const cur = fbPosts.find(y => y.id === x.id);
          if (cur && (x.statusAt || '') > (cur.statusAt || '')) Object.assign(cur, { status: x.status, statusReason: x.statusReason, statusAt: x.statusAt, seen: false });
        });
        fbPosts = [...added, ...fbPosts].sort((a, b) => (b.createdAt > a.createdAt ? 1 : -1));
        (data.requests || []).forEach(r => {
          const cur = fbRequests.find(y => y.id === r.id);
          if (!cur) fbRequests.push(r); else cur.answers = [...new Set([...(cur.answers || []), ...(r.answers || [])])];
        });
        await IDB.set('rt_fb_posts', fbPosts); await IDB.set('rt_fb_requests', fbRequests);
        renderPosts(); renderRequests();
        showToast(`${added.length} 件の投稿を読み込みました`);
      } catch (err) { showToast('読み込めませんでした：' + err.message); }
    });

