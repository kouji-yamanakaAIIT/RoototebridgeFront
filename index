    // ---------- 一言・音声・写真 ----------
    fb.text.addEventListener('input', markAiDirty);
    fb.personaNote.addEventListener('input', markAiDirty);
    let recog = null;
    fb.voiceBtn.addEventListener('click', () => {
      const SR = window.SpeechRecognition || window.webkitSpeechRecognition;
      if (!SR) { showToast('このブラウザでは音声入力を使えません（Chrome / Safari で利用できます）'); return; }
      if (recog) { recog.stop(); return; }
      try {
        recog = new SR();
