    // ---------- AI要約（数字はプログラムで計算し、AIは文章化だけ） ----------
    function statsDigest(posts, prevPosts, label, prevLabel) {
      const s = computeStats(posts), ps = prevPosts ? computeStats(prevPosts) : null;
      const themes = Object.entries(s.themes).sort((a, b) => b[1].total - a[1].total).slice(0, 6).map(([k, t]) => {
        const pt = ps && ps.themes[k] ? ps.themes[k].total : 0;
        return { theme: k, count: t.total, skip: t.skip, buy: t.buy, prev: ps ? pt : null };
      });
      const products = Object.values(s.products).sort((a, b) => b.total - a.total).slice(0, 6).map(r => ({
        product: shortName(productById(r.id) || { title: r.id }), count: r.total, skipRate: pct(r.skip, r.total) + '%', topTheme: (topKey(r.themes) || [''])[0], pending: r.pending, personaMatch: r.pa ? pct(r.pm, r.pa) + '%' : '回答なし'
      }));
      const quotes = posts.filter(p => p.text).sort((a, b) => weightOf(b) - weightOf(a)).slice(0, 6).map(p => `${shortName(productById(p.productId) || { title: '' })}：「${p.text}」（${p.count || '人数不明'}・${OUTCOME_LABEL[outcomeOf(p)]}）`);
      const decisions = posts.filter(p => p.statusReason && p.status !== '未確認').slice(0, 6).map(p => `${p.status}：${shortName(productById(p.productId) || { title: '' })} — ${p.statusReason}`);
      return {
        period: label, previousPeriod: prevLabel || null,
        totals: { posts: s.total, prevPosts: ps ? ps.total : null, skipRate: pct(s.skip, s.total) + '%', prevSkipRate: ps ? pct(ps.skip, ps.total) + '%' : null, status: s.status, personaMatch: s.persona.answered ? pct(s.persona.match, s.persona.answered) + '%' : '回答なし', personaGaps: s.persona.gaps },
        themes, products, quotes, decisions,
        openRequests: fbRequests.filter(r => !(r.answers || []).length).map(r => r.question)
      };
    }
    const DASH_AI_SCHEMA = {
      type: 'OBJECT',
      properties: {
        headline: { type: 'STRING' },
        insights: { type: 'ARRAY', items: { type: 'OBJECT', properties: { title: { type: 'STRING' }, detail: { type: 'STRING' }, evidence: { type: 'STRING' } }, required: ['title', 'detail', 'evidence'] } },
        concept: { type: 'STRING', description: 'コンセプト（設計ペルソナ）の浸透についての所見' },
        next_checks: { type: 'ARRAY', items: { type: 'STRING' } }
      },
      required: ['headline', 'insights', 'concept', 'next_checks']
    };
    async function aiSummarize(digest, audience) {
      const prompt = `あなたは ROOTOTE の「AI通訳」です。営業から集まった現場の声の集計結果を、${audience}向けに要約してください。

【集計結果（プログラムで計算済み。数字は変えずにそのまま使うこと）】
${JSON.stringify(digest, null, 1)}

【ルール】
- 数字は上の集計結果にあるものだけを使い、新しく計算したり推測したりしない。
- skip / skipRate は「お客さんが買わなかった声」。status の「見送り」（デザイナーが対応しないと決めたもの）とは別物なので、混同しないこと。文中では「買わなかった声」と書く。
- 1人の強い声と、多くの人に共通する声を区別して書く（件数・人数を根拠に）。
- 断定せず「〜の可能性」「〜を確かめる価値がある」と書く。
- insights は3つ。evidence には根拠になる数字か声を短く書く。
- next_checks は来月確かめることを2〜3個。
- 日本語で簡潔に。`;
      const apiKey = getEffectiveApiKey();
      try {
        const data = await fetchWithBackoff(`https://generativelanguage.googleapis.com/v1beta/models/gemini-3-flash-preview:generateContent?key=${apiKey}`, {
          method: 'POST', headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ contents: [{ parts: [{ text: prompt }] }], generationConfig: { temperature: 0.3, responseMimeType: 'application/json', responseSchema: DASH_AI_SCHEMA } })
        }, 3, [1000, 2000, 4000]);
        const txt = data?.candidates?.[0]?.content?.parts?.map(x => x.text || '').join('') || '';
        return { result: JSON.parse(txt.replace(/^```json\s*|\s*```$/g, '')), engine: 'Gemini 3 Flash' };
      } catch (e) {
        showToast('AIに接続できなかったため、内蔵エンジンで要約しました');
        return { result: offlineSummary(digest), engine: '内蔵エンジン' };
      }
    }
    function offlineSummary(g) {
      const t = g.themes[0], p = g.products[0];
      const insights = [];
      if (t) insights.push({ title: `「${t.theme}」の声が最多`, detail: `${t.theme}に関する声が${t.count}件あり、そのうち${t.skip}件は購入に至っていません。`, evidence: `${t.count}件（買わなかった${t.skip}件）${t.prev != null ? '／前の期間 ' + t.prev + '件' : ''}` });
      if (p) insights.push({ title: `${p.product}に声が集中`, detail: `${p.product}の声が${p.count}件で最多です。主なテーマは「${p.topTheme}」、買わなかった率は${p.skipRate}です。`, evidence: `${p.count}件・買わなかった率${p.skipRate}・未確認${p.pending}件` });
      const gap = Object.entries(g.totals.personaGaps || {}).sort((a, b) => b[1] - a[1])[0];
      insights.push({ title: '対応状況', detail: `未確認が${g.totals.status['未確認'] || 0}件あります。営業が投稿を続けられるよう、古いものから対応状況を返すことをおすすめします。`, evidence: `採用${g.totals.status['採用'] || 0}／検討中${g.totals.status['検討中'] || 0}／見送り${g.totals.status['見送り'] || 0}` });
      return {
        headline: `${g.period}は${g.totals.posts}件の声が集まり、買わなかった声は${g.totals.skipRate}でした。`,
        insights,
        concept: g.totals.personaMatch === '回答なし' ? 'ペルソナ照合の回答はまだありません。' : `想定したペルソナどおりの客層は${g.totals.personaMatch}でした。${gap ? '特に「' + gap[0] + '」のずれが' + gap[1] + '件あります。' : ''}`,
        next_checks: [t ? `「${t.theme}」で見送る人の具体的な場面` : '店頭での反応の継続収集', gap ? `「${gap[0]}」のずれが実際の客層の違いかどうか` : '想定ペルソナどおりの客層か'].filter(Boolean)
      };
    }
    function aiHtml(r) {
      return `<p class="text-[13px] font-semibold text-slate-800 mb-3">${esc(r.headline)}</p>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-2.5 mb-3">${(r.insights || []).map(i => `<div class="rounded-lg border border-slate-200 bg-slate-50 p-3"><p class="text-[12px] font-bold text-slate-800">${esc(i.title)}</p><p class="text-[11px] text-slate-600 mt-1 leading-relaxed">${esc(i.detail)}</p><p class="text-[10px] text-indigo-700 mt-1.5">根拠：${esc(i.evidence)}</p></div>`).join('')}</div>
