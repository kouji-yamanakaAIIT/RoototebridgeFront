    // ---------- AI整理 ----------
    function pinnedImageDataUrl() {
      return new Promise(resolve => {
        const src = fb.pinImg.src;
        if (!src || !fbState.pins.length) { resolve(src || null); return; }
        const img = new Image();
        img.onload = () => {
          const c = document.createElement('canvas');
          c.width = img.naturalWidth; c.height = img.naturalHeight;
          const ctx = c.getContext('2d');
          ctx.drawImage(img, 0, 0);
          const r = Math.max(12, Math.round(c.width * 0.03));
          fbState.pins.forEach((p, i) => {
            const x = p.x / 100 * c.width, y = p.y / 100 * c.height;
            ctx.beginPath(); ctx.arc(x, y, r, 0, Math.PI * 2);
            ctx.fillStyle = '#e11d48'; ctx.fill();
            ctx.lineWidth = Math.max(2, r * 0.2); ctx.strokeStyle = '#ffffff'; ctx.stroke();
            ctx.fillStyle = '#ffffff'; ctx.font = `bold ${Math.round(r * 1.1)}px sans-serif`;
            ctx.textAlign = 'center'; ctx.textBaseline = 'middle'; ctx.fillText(String(i + 1), x, y + 1);
          });
          resolve(c.toDataURL('image/jpeg', 0.88));
        };
        img.onerror = () => resolve(src);
        img.src = src;
      });
    }

    function fbInputSummaryText() {
      const s = fbState;
      const pins = s.pins.map((p, i) => `ピン${i + 1}：${p.part || '部位未選択'}${p.note ? '（' + p.note + '）' : ''}`).join('／');
      const req = s.requestId ? fbRequests.find(r => r.id === s.requestId) : null;
      return [
        `- 反応：${s.reaction.join('、') || '未選択'}`,
        `- 気になった点：${s.concern.join('、') || 'なし'}`,
        `- 同じ反応だった人数：${s.count || '未入力'}`,
        `- 客層：年代 ${s.age || '未入力'}／性別 ${s.gender || '未入力'}／同伴 ${s.with || '未入力'}`,
        `- ピン：${pins || 'なし'}`,
        `- お客さんの言葉・営業の気づき：${fb.text.value.trim() || 'なし'}`,
        `- 想定ペルソナとの一致：${s.persona || '未回答'}${s.personaGap.length ? '（違った点：' + s.personaGap.join('、') + '）' : ''}${fb.personaNote.value.trim() ? '／' + fb.personaNote.value.trim() : ''}`,
        s.talkUse ? `- 配信された営業トーク：${s.talkUse}` : '',
        req ? `- この投稿はデザイナーの確認依頼への回答：「${req.question}」` : ''
      ].filter(Boolean).join('\n');
    }

    const FB_SCHEMA = {
      type: 'OBJECT',
      properties: {
        summary: { type: 'STRING', description: 'デザイナー向けの1文要約' },
        facts: { type: 'ARRAY', items: { type: 'STRING' }, description: '観察された行動・実際の発言（事実）' },
        interpretations: { type: 'ARRAY', items: { type: 'STRING' }, description: '営業の推測・お客さんの評価（解釈）' },
        purchase: { type: 'OBJECT', properties: { status: { type: 'STRING', enum: ['購入', '見送り', '検討中', '不明'] }, reason: { type: 'STRING' } }, required: ['status', 'reason'] },
        pins: { type: 'ARRAY', items: { type: 'OBJECT', properties: { no: { type: 'INTEGER' }, part: { type: 'STRING' }, comment: { type: 'STRING' } }, required: ['no', 'part', 'comment'] } },
        designer_hint: { type: 'STRING', description: 'デザイナーが検討できる観点（断定しない）' },
        persona_gap: { type: 'STRING', description: '想定ペルソナとのずれ。なければ空文字' },
        request_answer: { type: 'STRING', description: '確認依頼への回答の要点。依頼がなければ空文字' },
        theme_tags: { type: 'ARRAY', items: { type: 'STRING' } },
        evidence: { type: 'STRING', enum: ['強', '中', '弱'], description: '根拠の強さ（人数・事実の有無）' },
        follow_up: { type: 'ARRAY', items: { type: 'OBJECT', properties: { question: { type: 'STRING' }, options: { type: 'ARRAY', items: { type: 'STRING' } } }, required: ['question', 'options'] } }
      },
      required: ['summary', 'facts', 'interpretations', 'purchase', 'pins', 'designer_hint', 'persona_gap', 'request_answer', 'theme_tags', 'evidence', 'follow_up']
    };

    function fbBuildPrompt() {
      const p = currentProduct;
      const persona = getPersona(p.id).trim();
      return `あなたは ROOTOTE の「AI通訳」です。営業が売り場で投稿した現場の声を、デザイナーが判断に使える形に整理してください。

【製品】
${catalogFactsText(p) || '- 製品名：' + p.title + '（カタログ外の製品）'}

【デザイナーの設計ペルソナ】
${persona || 'なし'}

【営業の入力】
${fbInputSummaryText()}

【添付画像】
- 1枚目：製品画像。営業が付けたピンを赤い丸の番号で描いてある（ピンがなければ製品画像のみ）
- 2枚目以降：営業が撮った売り場の写真（あれば）

【ルール】
- 「事実」は観察された行動と実際の発言だけ。営業の推測やお客さんの評価は「解釈」に分ける。
- 入力にないことを作らない。人数・客層が未入力なら推測しない。
- ピンは画像を見て、番号ごとに指している部位を特定し、営業が選んだ部位と食い違えば画像を優先して comment に書く。
- designer_hint は「〜の検討余地」「〜を確かめる価値がある」のように断定せず書く。
- 判断に重要なのに足りない情報があれば、follow_up に最大2問、ワンタップで答えられる2〜4個の選択肢つきで入れる（足りていれば空配列）。
- evidence は、人数が多く事実がそろっていれば「強」、1人・推測中心なら「弱」。
- すべて日本語で、短く書く。`;
    }

    async function runStructure() {
      if (!currentProduct) { showToast('製品を選んでください'); return; }
      if (!fbState.reaction.length) { showToast('「お客さんの反応」を1つ以上選んでください'); return; }
      fb.structureBtn.disabled = true;
      fb.aiStatus.className = 'w-2.5 h-2.5 rounded-full bg-amber-400 animate-ping';
      fb.aiBody.innerHTML = '<div class="py-8 flex flex-col items-center gap-3"><div class="w-8 h-8 border-4 border-indigo-200 border-t-indigo-600 rounded-full animate-spin"></div><p class="text-xs text-slate-500">現場の声を整理しています…</p></div>';
      const apiKey = getEffectiveApiKey();
      try {
        const parts = [{ text: fbBuildPrompt() }];
        const pinned = await pinnedImageDataUrl();
        if (pinned) parts.push({ inlineData: { mimeType: 'image/jpeg', data: pinned.split(',')[1] } });
        fbState.photos.slice(0, 2).forEach(src => parts.push({ inlineData: { mimeType: 'image/jpeg', data: src.split(',')[1] } }));
        const data = await fetchWithBackoff(`https://generativelanguage.googleapis.com/v1beta/models/gemini-3-flash-preview:generateContent?key=${apiKey}`, {
          method: 'POST', headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ contents: [{ parts }], generationConfig: { temperature: 0.2, responseMimeType: 'application/json', responseSchema: FB_SCHEMA } })
        }, 3, [1000, 2000, 4000]);
        const txt = data?.candidates?.[0]?.content?.parts?.map(x => x.text || '').join('') || '';
        fbState.ai = JSON.parse(txt.replace(/^```json\s*|\s*```$/g, ''));
        fbState.aiEngine = 'Gemini 3 Flash';
      } catch (err) {
        fbState.ai = offlineStructure();
        fbState.aiEngine = '内蔵エンジン';
        showToast('AIに接続できなかったため、内蔵エンジンで整理しました');
      } finally {
        fb.structureBtn.disabled = false;
      }
      fbState.ai.follow_up = (fbState.ai.follow_up || []).map(q => ({ ...q, answer: '' }));
      fbState.aiDirty = false;
      fb.aiStatus.className = 'w-2.5 h-2.5 rounded-full bg-emerald-500';
      fb.aiEngine.textContent = fbState.aiEngine;
      renderAiResult(fb.aiBody, fbState.ai, true);
      updateSubmitState();
      if (isFbMobile()) fb.aiBody.closest('section').scrollIntoView({ behavior: 'smooth', block: 'start' });
    }

    function offlineStructure() {
      const s = fbState;
      const text = fb.text.value.trim();
      const facts = [];
      s.reaction.forEach(r => facts.push(`お客さんが「${r}」`));
      const quotes = text.match(/「[^」]+」/g);
      if (quotes) quotes.forEach(q => facts.push(`発言：${q}`));
      const interp = s.concern.map(c => `${c}が気になった様子`);
      if (text && !quotes) interp.push(`営業の気づき：${text}`);
      const purchase = s.reaction.includes('購入') ? '購入' : s.reaction.includes('見送り') || s.reaction.includes('すぐ戻した') ? '見送り' : '不明';
      const follow = [];
      if (!s.count) follow.push({ question: '同じ反応だったのは何人くらいですか？', options: FB_OPTS.count });
      if (!s.age && !s.gender) follow.push({ question: 'どんなお客さんでしたか？', options: ['20〜30代女性', '40代以上女性', '男性', '子連れ'] });
      const persona = getPersona(currentProduct.id).trim();
      const req = s.requestId ? fbRequests.find(r => r.id === s.requestId) : null;
      return {
        summary: `${currentProduct.title.replace(/\s*\/\s*\d+$/, '')}：${s.reaction.join('・')}${s.concern.length ? '（' + s.concern.join('・') + '）' : ''}`,
        facts: facts.length ? facts : ['反応のみ入力'],
        interpretations: interp,
        purchase: { status: purchase, reason: s.concern.length ? s.concern.join('・') + 'が影響した可能性' : '理由は未入力' },
        pins: s.pins.map((p, i) => ({ no: i + 1, part: p.part || '部位未選択', comment: p.note || '' })),
        designer_hint: s.concern.length ? `${s.concern.join('・')}について検討の余地` : '傾向を見るため、同様の声が集まるか確認',
        persona_gap: persona && s.persona && s.persona !== '想定どおり' ? `${s.persona}${s.personaGap.length ? '（' + s.personaGap.join('・') + '）' : ''}${fb.personaNote.value.trim() ? '：' + fb.personaNote.value.trim() : ''}` : '',
        request_answer: req ? `依頼「${req.question.slice(0, 24)}…」に対し：${s.reaction.join('・')}${s.count ? '（' + s.count + '）' : ''}` : '',
        theme_tags: [...s.concern, ...s.pins.map(p => p.part).filter(Boolean)],
        evidence: s.count === '4人以上' ? '強' : s.count === '2〜3人' ? '中' : '弱',
        follow_up: follow
      };
    }

    function renderAiResult(container, ai, interactive) {
      const list = arr => (arr && arr.length) ? `<ul class="list-disc pl-4 space-y-0.5">${arr.map(x => `<li>${esc(x)}</li>`).join('')}</ul>` : '<p class="text-slate-400">—</p>';
      const purchaseColor = { '購入': 'text-emerald-700 bg-emerald-50', '見送り': 'text-rose-700 bg-rose-50', '検討中': 'text-amber-800 bg-amber-50' }[ai.purchase?.status] || 'text-slate-600 bg-slate-100';
      const evColor = { '強': 'bg-emerald-100 text-emerald-800', '中': 'bg-amber-100 text-amber-800', '弱': 'bg-slate-100 text-slate-600' }[ai.evidence] || 'bg-slate-100 text-slate-600';
      container.innerHTML = `
        <p class="text-[13px] font-semibold text-slate-800 leading-snug">${esc(ai.summary)}</p>
