      const concept = Object.values(s.products).filter(r => r.pa).sort((a, b) => b.pa - a.pa).slice(0, 5);
      const notable = posts.filter(p => p.text).sort((a, b) => weightOf(b) - weightOf(a) || b.createdAt.localeCompare(a.createdAt)).slice(0, 3);
      const d = (cur, prev, unit = '件') => { const x = cur - prev; return x === 0 ? '前月と同じ' : `前月比 ${x > 0 ? '+' : '−'}${Math.abs(x)}${unit}`; };
      const demoUsed = posts.some(p => p.demo);
      rep.sheet.innerHTML = `
